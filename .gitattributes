# Normalize line endings
* text=auto eol=lf

# Force LF for these types
*.py text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.txt text eol=lf

# Windows scripts: keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files - no processing
*.mp4 binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.svg text eol=lf
