# ============================================================
# AI Video Automation Engine - Environment Variables
# Copy this file to .env and fill in real values.
# ============================================================

# --- RUNTIME ---
APP_NAME=ai-video-engine
LOG_LEVEL=INFO

# --- BACKENDS ---
JOB_BACKEND=memory
ARTIFACT_STORE_BACKEND=local

# --- FFMPEG ---
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- WHISPER (Speech-to-Text) ---
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- TRANSLATION ---
TRANSLATOR_SERVICE=google
DEEPL_API_KEY=
LIBRETRANSLATE_URL=http://localhost:5000

# --- TTS (Text-to-Speech) ---
TTS_ENGINE=edge-tts
TTS_DEFAULT_VOICE=vi-VN-HoaiMyNeural
TTS_RATE=+0%
TTS_VOLUME=+0%

# --- SUPABASE (Production queue + artifact store) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
SUPABASE_JOBS_TABLE=jobs
SUPABASE_STORAGE_BUCKET=artifacts

# --- PATHS ---
OUTPUT_DIR=output
TEMP_DIR=temp
LOGS_DIR=logs
CACHE_DIR=cache

# --- PROCESSING ---
MAX_WORKERS=2
WORKER_POLL_INTERVAL_SECONDS=1
JOB_LEASE_SECONDS=30
HEARTBEAT_INTERVAL_SECONDS=10
CANCEL_GRACE_SECONDS=5
STEP_RETRY_ATTEMPTS=2
STEP_RETRY_DELAY_SECONDS=1
MAX_AUDIO_STRETCH=1.3
CACHE_VERSION=v1
WORKER_ID=

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me-in-production
API_AUTH_ENABLED=true
API_EMBEDDED_WORKER=true
